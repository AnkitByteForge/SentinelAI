# Optional. docker-compose.yml reads this automatically for host-port
# overrides — only needed if the defaults (5432, 8000) collide with
# something else already running on your machine. Copy to .env and adjust:
#   cp .env.example .env
#
# This is separate from backend/.env (application config/secrets) and
# frontend/.env.local (dashboard config) — this file only affects which
# host ports docker-compose publishes to.

POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000

# If you change POSTGRES_HOST_PORT, also update POSTGRES_URL in
# backend/.env to match (host processes like scripts/bootstrap.py connect
# via that host port, not the container-internal one).
