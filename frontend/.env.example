# Dashboard server configuration. Copy to .env.local: cp .env.example .env.local
# Neither of these is NEXT_PUBLIC_ — both are read only by the server-side
# proxy at app/api/gateway/[...path]/route.ts and never reach the browser.

# Backend URL reachable from the Next.js server process (not the browser).
# In docker-compose this is the backend service's internal address;
# for local dev it's usually http://localhost:8000.
BACKEND_INTERNAL_URL=http://localhost:8000

# API key the dashboard uses to call the backend. Use a low-rate-limit,
# non-master key minted via POST /v1/keys (see README) — not the master
# admin API_KEY, which can create/revoke other keys.
SENTINEL_API_KEY=your_dashboard_key_here
