# SentinelAI backend configuration
# Copy this file to .env and fill in real values: cp .env.example .env
# (scripts/bootstrap.py does this for you automatically if backend/.env is missing.)

# ── LLM provider keys ──────────────────────────────────────────────────
# Required. Get a free key at https://console.groq.com — primary provider.
GROQ_API_KEY=your_groq_key_here

# Required. Get a free key at https://aistudio.google.com/apikey — fallback provider.
GEMINI_API_KEY=your_gemini_key_here

# ── Database ────────────────────────────────────────────────────────────
# Required. Async SQLAlchemy connection string — must be postgresql+asyncpg://
# and point at a database with the pgvector extension available.
# The docker-compose "postgres" service exposes exactly this URL on localhost.
POSTGRES_URL=postgresql+asyncpg://sentinel:sentinel_dev_pass@localhost:5432/sentinelai

# Optional. Legacy SQLite URL from an early prototype; not used by the active
# engine (see app/db/database.py). Safe to leave at its default.
DATABASE_URL=sqlite+aiosqlite:///./sentinelai.db

# ── Gateway auth ────────────────────────────────────────────────────────
# Required. Master admin key — always valid, bypasses per-key rate limiting.
# Used to bootstrap the system and to call /v1/keys (API key management).
# Generate a real one for anything beyond local dev, e.g.: openssl rand -hex 24
API_KEY=sentinel-dev-key-123

# Optional. Informational only — not currently branched on in code.
ENVIRONMENT=development

# ── Redis ───────────────────────────────────────────────────────────────
# Required. Backs the API key lookup cache and per-key rate limiting.
REDIS_URL=redis://localhost:6379/0

# Required. Celery broker (task queue) and result backend. Point these at a
# managed Redis (e.g. Upstash, ElastiCache) in production — see README.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── API key management ──────────────────────────────────────────────────
# Optional. How long a resolved API key stays cached in Redis before the
# next lookup re-checks Postgres (e.g. to pick up a revocation).
API_KEY_CACHE_TTL_SECONDS=60

# Optional. Default requests-per-minute limit applied to a new key when the
# caller doesn't specify one in POST /v1/keys.
DEFAULT_RATE_LIMIT_PER_MINUTE=100

# ── Circuit breaker webhook ────────────────────────────────────────────
# Optional. If unset, webhook delivery is skipped entirely — nothing else
# depends on it. Set to your monitoring/alerting endpoint to get notified
# when a provider's circuit opens or recovers.
WEBHOOK_URL=

# Optional. HMAC-SHA256 signing secret for the X-Sentinel-Signature header,
# so your webhook receiver can verify the payload came from SentinelAI.
WEBHOOK_SECRET=

# Optional. Timeout for webhook delivery — delivery runs in a Celery task,
# so this never blocks request processing either way.
WEBHOOK_TIMEOUT_SECONDS=5.0

# ── Health checks ───────────────────────────────────────────────────────
# Optional. Per-dependency timeouts used by /health, /health/ready.
HEALTH_DB_TIMEOUT_SECONDS=2.0
HEALTH_REDIS_TIMEOUT_SECONDS=1.0

# Optional. Celery queue depth above which /health reports "degraded".
CELERY_QUEUE_DEPTH_DEGRADED_THRESHOLD=50

# ── Performance / profiling toggles ─────────────────────────────────────
# Optional. If true, loads the SentenceTransformer embedding model at
# process startup instead of lazily on first cache check.
PRELOAD_EMBEDDING_MODEL=false

# Optional. If true, logs per-stage timing breakdowns for every /v1/chat call.
LOG_STAGE_TIMINGS=false
